{
  "name": "pi-agent",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-model.mjs",
    "login": "node scripts/login.mjs",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=2 test/*.test.ts",
    "corpus:record": "node scripts/record-geocoding.mjs",
    "diagnose": "node scripts/diagnose-tg-runtime.mjs",
    "doctor": "npm run diagnose",
    "compose:up": "bash scripts/compose-up.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "0.6.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "cron-parser": "5.10.1",
    "jsdom": "29.1.1",
    "marked": "18.1.0",
    "node-html-markdown": "2.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "0.12.0",
    "typebox": "1.4.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "zod": "^4.6.5"
  }
}
